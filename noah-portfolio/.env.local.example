OPENROUTER_API_KEY=
# Default chosen on /benchmark (2026-10-09): every mode and boundary question right at about $1 per 1,000 sites, where the self-hosted models took 34 to 65 s and invented answers. Keep fallbacks on: OpenRouter's fires on any primary-model error, the app's own retry only on a 402.
OPENROUTER_MODEL=anthropic/claude-haiku-5.5
# Optional provider preference (comma-separated OpenRouter provider slugs); fallbacks remain enabled. Benchmark quality was measured with OpenRouter's default routing; pinning a provider can change quality, so re-run scripts/story-model-eval.ts after pinning.
# OPENROUTER_PROVIDER_ORDER=anthropic
# Free-tier fallback chain defaults in code to tencent/hy3:free; set "" to disable. OpenRouter's server-side fallback and an app-level 402 retry are both active. tencent/hy3:free is the only free model usable without opting into prompt-logging at https://openrouter.ai/settings/privacy (verified 2026-07-20).
OPENROUTER_FALLBACK_MODELS=tencent/hy3:free
# Optional OpenAI-compatible endpoint instead of OpenRouter, e.g. a local Ollama server: http://localhost:11434/v1 (set OPENROUTER_API_KEY to any non-empty value and OPENROUTER_FALLBACK_MODELS="" there).
# OPENROUTER_BASE_URL=
# Optional reasoning effort sent as `reasoning: { effort }`: xhigh, high, medium, low, minimal or none. "none" turns thinking off on models that support it (e.g. qwen3.5 on Ollama).
# OPENROUTER_REASONING_EFFORT=
CF_ACCOUNT_ID=
CF_D1_DATABASE_ID=
CF_D1_TOKEN=
# Server-only HMAC key used for private Story cache identity. Use a long random value in production.
STORY_CACHE_HMAC_KEY=
# Non-secret rotation label. Change it whenever STORY_CACHE_HMAC_KEY changes.
STORY_CACHE_HMAC_KEY_ID=
# Langfuse observability (optional). When both keys are set, Story generations are traced.
# Keys: Langfuse project > Settings > API Keys. Leave unset to disable tracing locally.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Base URL selects the data region: https://cloud.langfuse.com (EU) or https://us.cloud.langfuse.com (US), or a self-hosted URL.
LANGFUSE_BASE_URL=https://cloud.langfuse.com
